# Server Environment Variables
PORT=5000
NODE_ENV=development

# Postgres / Neon Connection String
# e.g. postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/pawmatch?sslmode=require
DATABASE_URL=

# MongoDB Atlas Connection String
# e.g. mongodb+srv://username:password@cluster0.xyz.mongodb.net/pawmatch?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=pawmatch_super_secret_jwt_key_2026_dev_secure

# Google Gemini API Key (free tier)
GEMINI_API_KEY=

# Allowed Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
